# ─────────────────────────────────────────────────────────────────────────────
# Fastfile — All1Fit iOS
# ─────────────────────────────────────────────────────────────────────────────
# Lanes disponibles:
#   fastlane bump_build               → Incrementa build number desde TestFlight
#   fastlane beta                     → Build + sube a TestFlight
#   fastlane release                  → Build + sube al App Store (sin review)
#   fastlane release submit:true      → Build + sube + envía a review
#   fastlane upload_only              → Sube la última .ipa sin recompilar
#   fastlane metadata version:X.Y.Z  → Sube metadata ASO
#   fastlane screenshots              → Sube screenshots
#   fastlane privacy                  → Publica etiquetas de privacidad (pide Apple ID + 2FA)
#   fastlane status                   → Estado actual en App Store Connect
# ─────────────────────────────────────────────────────────────────────────────

default_platform(:ios)

BUNDLE_ID        = "com.idanidev.All1Fit"
BUNDLE_ID_WATCH  = "com.idanidev.All1Fit.watchkitapp"
BUNDLE_ID_WIDGET = "com.idanidev.All1Fit.All1FitWidgets"
XCODEPROJ        = "All1Fit.xcodeproj"
SCHEME           = "All1Fit"

# ── Helper: API Key ─────────────────────────────────────────────────────────
def asc_api_key
  app_store_connect_api_key(
    key_id:       ENV["ASC_KEY_ID"],
    issuer_id:    ENV["ASC_ISSUER_ID"],
    key_filepath: ENV["ASC_KEY_FILEPATH"],
    duration:     1200,
    in_house:     false
  )
end

platform :ios do

  # ── Versioning ──────────────────────────────────────────────────────────────

  desc "Incrementa el build number al siguiente de TestFlight"
  lane :bump_build do
    api_key = asc_api_key
    latest = latest_testflight_build_number(
      api_key:        api_key,
      app_identifier: BUNDLE_ID
    )
    next_build = latest + 1
    increment_build_number(
      build_number: next_build,
      xcodeproj:    XCODEPROJ
    )
    UI.success "Build number: #{next_build}"
  end

  # ── Build & Deploy ──────────────────────────────────────────────────────────

  desc "Build + sube beta a TestFlight"
  lane :beta do |options|
    api_key = asc_api_key

    bump_build

    gym(
      scheme:            SCHEME,
      configuration:     "Release",
      export_method:     "app-store",
      export_options: {
        signingStyle:       "automatic",
        teamID:             ENV["TEAM_ID"]
      },
      output_directory:  "build",
      output_name:       "All1Fit.ipa",
      clean:             true
    )

    upload_to_testflight(
      api_key:                           api_key,
      skip_waiting_for_build_processing: true,
      changelog:                         options[:changelog] || "Nueva versión beta."
    )

    UI.success "Beta subida a TestFlight!"
  end

  desc "Build + sube al App Store. Usa submit:true para enviar a review directamente"
  lane :release do |options|
    api_key = asc_api_key

    bump_build

    gym(
      scheme:           SCHEME,
      configuration:    "Release",
      export_method:    "app-store",
      export_options: {
        signingStyle:       "automatic",
        teamID:             ENV["TEAM_ID"]
      },
      output_directory: "build",
      output_name:      "All1Fit.ipa",
      clean:            true
    )

    should_submit = options[:submit].to_s == "true"

    upload_to_app_store(
      api_key:                            api_key,
      submit_for_review:                  should_submit,
      automatic_release:                  false,
      force:                              true,
      skip_screenshots:                   true,
      skip_metadata:                      false,
      precheck_include_in_app_purchases:  false,
      submission_information: {
        export_compliance_uses_encryption: false,
        add_id_info_uses_idfa:            false
      }
    )

    if should_submit
      UI.success "App subida y enviada a review!"
    else
      UI.success "App subida al App Store. Lista para enviar a review."
    end
  end

  desc "Sube la última .ipa sin recompilar. Usa submit:true para enviar a review"
  lane :upload_only do |options|
    api_key = asc_api_key

    ipa_path = "build/All1Fit.ipa"
    UI.user_error!("No se encontró #{ipa_path}. Ejecuta primero fastlane release.") unless File.exist?(ipa_path)

    should_submit = options[:submit].to_s == "true"

    upload_to_app_store(
      api_key:                            api_key,
      ipa:                                ipa_path,
      submit_for_review:                  should_submit,
      automatic_release:                  false,
      force:                              true,
      skip_screenshots:                   true,
      skip_metadata:                      true,
      precheck_include_in_app_purchases:  false,
      submission_information: {
        export_compliance_uses_encryption: false,
        add_id_info_uses_idfa:            false
      }
    )

    UI.success "IPA subida#{should_submit ? ' y enviada a review' : ''}!"
  end

  # ── Metadata ASO ────────────────────────────────────────────────────────────

  desc "Sube metadata ASO sin build. Usa version:X.Y.Z para versión específica"
  lane :metadata do |options|
    api_key = asc_api_key

    params = {
      api_key:                            api_key,
      skip_binary_upload:                 true,
      skip_screenshots:                   true,
      skip_metadata:                      false,
      force:                              true,
      precheck_include_in_app_purchases:  false
    }

    params[:app_version] = options[:version] if options[:version]

    upload_to_app_store(params)

    UI.success "Metadata ASO subida al App Store."
  end

  # ── Screenshots ─────────────────────────────────────────────────────────────

  desc "Sube screenshots existentes al App Store Connect"
  lane :screenshots do
    api_key = asc_api_key

    upload_to_app_store(
      api_key:               api_key,
      skip_binary_upload:    true,
      skip_metadata:         true,
      force:                 true,
      screenshots_path:      "screenshots_appstore_6.5",
      overwrite_screenshots: true,
      precheck_include_in_app_purchases: false
    )

    UI.success "Screenshots subidas al App Store."
  end

  # ── Privacidad ──────────────────────────────────────────────────────────────

  desc "Sube y publica las etiquetas de privacidad desde fastlane/app_privacy_details.json"
  lane :privacy do
    # Esta acción NO admite la API key: pide login con Apple ID + 2FA.
    upload_app_privacy_details_to_app_store(
      username:       ENV["APPLE_ID"],
      team_id:        ENV["ITC_TEAM_ID"],
      app_identifier: BUNDLE_ID,
      json_path:      "fastlane/app_privacy_details.json"
    )

    UI.success "Etiquetas de privacidad publicadas."
  end

  # ── Status ──────────────────────────────────────────────────────────────────

  desc "Muestra el estado actual de la app en App Store Connect"
  lane :status do
    api_key = asc_api_key

    version = get_version_number(xcodeproj: XCODEPROJ, target: "All1Fit")
    build   = get_build_number(xcodeproj: XCODEPROJ)

    latest_tf = latest_testflight_build_number(
      api_key:        api_key,
      app_identifier: BUNDLE_ID
    )

    UI.important "─── All1Fit Status ───"
    UI.message   "Versión local:        #{version} (#{build})"
    UI.message   "Último build en TF:   #{latest_tf}"
    UI.important "──────────────────────"
  end

end
