# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno para Fastlane — All1Fit
# Copia este archivo como `.env` y rellena los valores reales.
# NUNCA subas el archivo `.env` al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# Apple Developer
APPLE_ID=tu@email.com
TEAM_ID=XXXXXXXXXX          # Developer Portal Team ID (10 caracteres)
ITC_TEAM_ID=XXXXXXXXX       # App Store Connect Team ID (numérico)

# App Store Connect API Key (.p8)
# Genera la clave en: App Store Connect → Users & Access → Keys → App Manager
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ASC_KEY_FILEPATH=~/private_keys/AuthKey_XXXXXXXXXX.p8

# Match — repo Git privado para certificados
# Crea un repo privado vacío en GitHub y pega la URL aquí
MATCH_GIT_URL=git@github.com:tuusuario/all1fit-certs.git

# Opcional: changelog para betas de TestFlight
# BETA_CHANGELOG=Fixes y mejoras de rendimiento.
